{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["https://khaopiyo.ventron.in"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "opener:default",
    "notification:default",
    "allow-list-serial-ports",
    "allow-print-ticket",
    "allow-get-default-windows-printer",
    "allow-save-session",
    "allow-load-session",
    "allow-clear-session",
    "allow-save-bridge-token",
    "allow-load-bridge-token",
    "allow-clear-bridge-token"
  ]
}
