# counter — environment template. Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase (get these from Supabase → Project Settings → API) ──────────────
# Public: safe to expose to the browser. Used by the client + server for RLS-scoped access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret: SERVER ONLY. Bypasses RLS. Used to create anonymous QR orders with
# server-validated prices/totals. Never prefix with NEXT_PUBLIC_ — it must never
# reach the browser bundle. (spec §35)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Payments (Razorpay) — SERVER ONLY, all optional until configured ────────
# Platform-level keys — used for KhaoPiyo's OWN billing of cafés (Razorpay
# Subscriptions, app/api/platform-billing/*), not a café's customer payments.
# Per-café keys are entered by the café owner in Profile → Payments and
# stored encrypted — not env vars. Create each plan's subscription Plan in
# the Razorpay dashboard first, then set its ID on platform_plans.razorpay_plan_id
# (via platform-admin or SQL) — billing for a plan is simply unavailable,
# not broken, until that's set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Verifies requests to /api/platform-billing/check-expiry actually came from
# Vercel Cron (see vercel.json), not an open endpoint. Optional locally —
# the route allows unauthenticated calls when unset, for local testing.
CRON_SECRET=

# 32-byte key (base64 or hex), used to AES-256-GCM encrypt each café's own
# Razorpay secret before it's stored. Required before any café can connect
# Razorpay — without it, online payments stay unavailable, not insecure.
PAYMENTS_ENC_KEY=

# ── SMS (bill receipts, phone verification) — SERVER ONLY, optional ─────────
# SMS_PROVIDER selects which block below is used: "msg91" or "twilio". Leave
# unset to run without SMS — the product works fully without it.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
